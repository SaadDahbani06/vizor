# OPTIONAL. The offline demo runs without any of these. Never commit the real .env.

# --- External data (read-only)
FRED_API_KEY=
NESSIE_API_KEY=
NESSIE_BASE_URL=https://prod-api.nessieisreal.com
SEC_USER_AGENT=MainStreetDecisionDesk/0.1 contact@example.com
EIA_API_KEY=

# --- AI analyst (Gemini first; falls back to the rule-based offline analyst)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
# GEMINI_FALLBACK_MODELS=gemini-3.1-flash-lite,gemini-3.5-flash   # tried only on 429/5xx
# GEMINI_TIMEOUT_S=60                                         # per request
# GEMINI_THINKING_LEVEL=low                                  # minimal|low|medium|high|default
# MSRD_GEMINI_MAX_CALLS_PER_HOUR=120                         # local request budget
# MSRD_LLM_PROVIDER=gemini|claude|offline                    # force a provider
ANTHROPIC_API_KEY=                                           # optional alternative provider
# MSRD_AGENT_MODEL=claude-opus-5-5

# --- Photon 2.0 (Beta) iMessage / SMS
PHOTON_API_KEY=            # project API key, starts with pho_sk_
PHOTON_PROJECT_ID=         # starts with pho_prj_
PHOTON_WEBHOOK_SECRET=     # whsec_..., only if you expose a public HTTPS webhook endpoint
# MSRD_MAX_MESSAGES_PER_DAY=40                               # outbound cap (protects credits)
# MSRD_MESSAGING_STATE=data/cache/messaging_state.json       # gitignored; holds phone handles

# --- Business data connectors (docs/INGESTION.md). Sandbox first; tokens stay on the server.
QBO_CLIENT_ID=
QBO_CLIENT_SECRET=
QBO_REDIRECT_URI=http://localhost:8501/qbo-callback
QBO_ENVIRONMENT=sandbox                 # sandbox | production
# QBO_MINOR_VERSION=75
# QBO_TOKEN_PATH=data/private/quickbooks_tokens.json   # gitignored, chmod 600
# QBO_LIVE_TEST=1                       # opt-in live test against your sandbox company
SQUARE_ACCESS_TOKEN=
SQUARE_LOCATION_ID=
SQUARE_ENVIRONMENT=sandbox              # sandbox | production
# SQUARE_VERSION=2025-01-23
# SQUARE_LIVE_TEST=1

# --- Misc
# MSRD_FAST=1                        # UI: 4 fast models (tests/demos)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
